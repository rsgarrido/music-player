    <string name="tips_library_category">Biblioteca</string>
    <string name="tips_library_category_summary">Encuentra, califica y organiza tu música.</string>
    <string name="tips_personalize_category">Personalizar y proteger</string>
    <string name="tips_personalize_category_summary">Personaliza el reproductor y guarda los datos de la app.</string>
    <string name="tips_saved_queues_title">Colas guardadas</string>
    <string name="tips_saved_queues_body">Usa el centro de colas para crear distintas colas de reproducción guardadas y cambiar entre ellas.</string>
    <string name="tips_play_next_title">Controla qué se reproduce después</string>
    <string name="tips_play_next_body">Usa Reproducir a continuación para agregar música a la cola o arrastra los elementos del centro de colas para cambiar su orden.</string>
    <string name="tips_player_album_title">Abre un álbum desde el reproductor</string>
    <string name="tips_player_album_body">En los temas compatibles del reproductor ampliado, toca el título del álbum para abrirlo en la Biblioteca.</string>
    <string name="tips_lyrics_title">Letras locales</string>
    <string name="tips_lyrics_body">Abre la letra local desde el reproductor ampliado cuando haya un archivo de letras correspondiente.</string>
    <string name="tips_quick_rate_title">Calificación rápida</string>
    <string name="tips_quick_rate_body">Usa Calificación rápida en la sección Con calificación para calificar varias canciones fácilmente.</string>
    <string name="tips_filters_title">Filtros y desplazamiento rápido</string>
    <string name="tips_filters_body">Filtra tu biblioteca por género, año o calificación y desplázate rápidamente por las listas largas compatibles.</string>
    <string name="tips_smart_playlists_title">Listas de reproducción inteligentes</string>
    <string name="tips_smart_playlists_body">Crea una lista de reproducción inteligente con tus propias reglas; las canciones se actualizan automáticamente.</string>
    <string name="tips_metadata_title">Editar metadatos</string>
    <string name="tips_metadata_body">Abre Editar etiquetas desde las acciones de una canción para corregir los metadatos compatibles del archivo de música.</string>
    <string name="tips_my_player_title">Mi reproductor</string>
    <string name="tips_my_player_body">Mi reproductor guarda tu apariencia personalizada. Si eliges un estilo predefinido, se conserva; si lo editas, el resultado se guarda como Mi reproductor.</string>
    <string name="tips_backup_title">Copia de seguridad y restauración</string>
    <string name="tips_backup_body">Exporta y restaura los datos compatibles de la app. Al restaurar, se borran las colas guardadas y la reproducción actual.</string>
