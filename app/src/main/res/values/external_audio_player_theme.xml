<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A floating Activity window: no overlay permission or full-screen app shell. -->
    <style name="Theme.Sazanami.ExternalAudioPlayer" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
